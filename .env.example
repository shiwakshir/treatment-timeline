# Copy this file to .env.local and fill in your free Google AI Studio key.
# Never commit .env.local to version control.

DATABASE_URL="file:./dev.db"
GEMINI_API_KEY="your_free_google_ai_studio_api_key_here"

# Optional: Set to "true" ONLY during local development if you want raw answer text
# stored in SafetyTriggerLog. By default ("false"), only metadata is logged.
DEV_LOG_TEXT="false"

# Optional: Minimum gap between Gemini API calls in milliseconds (default: 6000)
GEMINI_MIN_GAP_MS="6000"
