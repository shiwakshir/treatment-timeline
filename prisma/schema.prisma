// Local SQLite schema for treatment-timeline (Phase 1 Prototype)
// Designed to remain open for Phases 2-5 (photo upload, voice, clinician share links, carer input)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model PatientProfile {
  id                String             @id @default(cuid())
  displayName       String
  preferredLanguage String             @default("en") // "en" | "hi"
  storySummaryEn    String
  storySummaryHi    String
  createdAt         DateTime           @default(now())
  medications       MedicationPeriod[]
}

model MedicationPeriod {
  id                    String                @id @default(cuid())
  patientId             String
  patient               PatientProfile        @relation(fields: [patientId], references: [id], onDelete: Cascade)

  // Core medication fields. Any field can be "unknown" (never guessed).
  genericName           String                @default("unknown")
  dose                  String                @default("unknown")
  startDate             String                @default("unknown") // YYYY-MM, YYYY-MM-DD, or "unknown"
  stopDate              String                @default("unknown") // YYYY-MM, YYYY-MM-DD, "ongoing", or "unknown"

  // Guided interview responses (raw verbatim patient words + plain summaries)
  adherenceRaw          String
  adherenceSummaryEn    String
  adherenceSummaryHi    String
  adherenceUnknown      Boolean               @default(false)

  effectRaw             String
  effectSummaryEn       String
  effectSummaryHi       String
  effectUnknown         Boolean               @default(false)

  sideEffectsRaw        String
  sideEffectsSummaryEn  String
  sideEffectsSummaryHi  String
  sideEffectsUnknown    Boolean               @default(false)

  stoppingReasonRaw       String
  stoppingReasonSummaryEn String
  stoppingReasonSummaryHi String
  stoppingReasonUnknown   Boolean             @default(false)

  // Nothing appears on the timeline unless confirmedAt is non-null
  confirmedAt           DateTime?
  createdAt             DateTime              @default(now())

  // Extension hooks for Later Phases (Phases 2, 3, 5)
  sourceType            String                @default("TEXT")    // Phase 2: "PHOTO_OCR", Phase 3: "VOICE"
  recordedByRole        String                @default("PATIENT") // Phase 5: "CARER"
  carerRelationship     String?                                   // Phase 5 optional metadata

  expressions           ExtractedExpression[]
}

model ExtractedExpression {
  id                    String           @id @default(cuid())
  medicationPeriodId    String
  medicationPeriod      MedicationPeriod @relation(fields: [medicationPeriodId], references: [id], onDelete: Cascade)

  questionCategory      String           // "adherence" | "effect" | "side_effects" | "stopping_reason"
  originalPhrase        String           // Exact phrase in patient's words
  candidateMeaningsJson String           // JSON string[] of up to 3 candidate clinical meanings
  selectedMeaning       String           // Confirmed meaning chosen by user (or verbatim fallback)
  confidence            String           // "high" | "medium" | "low"
  matchedLexiconTerm    String?          // Reference term from data/lexicon.json if matched
}

model SafetyTriggerLog {
  id               String   @id @default(cuid())
  createdAt        DateTime @default(now())
  eventType        String   // "URGENT_TRIGGER" | "FAIL_SAFE"
  questionCategory String?  // Which interview step was active
  whichCheckFired  String   // "keyword" | "classifier" | "both" | "classifier_failure"
  matchedKeyword   String?  // Populated if keyword list matched
  classifierLabel  String?  // Classifier category or technical error code
  failureReason    String?  // Populated on FAIL_SAFE technical errors
  answerText       String?  // Null by default; stored ONLY when DEV_LOG_TEXT=true in .env.local
}
